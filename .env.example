# auto-apply — example of NON-sensitive environment variables.
# Normal use needs no .env at all; defaults are fine. Copy to .env only for local development.
#
# Sensitive values NEVER go here or in any .env: no passwords, no ID numbers, no tokens, no bank data.
# The only credential the tool knows about is the Codex-only job-search password, and it lives
# exclusively in ~/auto-apply-data/<profile_id>/secrets.env (chmod 600, gitignored). See SECURITY.md §1.2.

# Root of all user data (each profile in a subdirectory). "~" is expanded by the entry layer.
# 数据根目录 / data root. Default ~/auto-apply-data
AUTO_APPLY_DATA_DIR=~/auto-apply-data

# Which profile to operate on: ~/auto-apply-data/<AUTO_APPLY_PROFILE>/
AUTO_APPLY_PROFILE=default

# User-facing language for prompts and reports: zh | en (default: follow the user's language at intake)
AUTO_APPLY_LANG=zh

# Log level for runs/<run_id>/log.jsonl: INFO | DEBUG. DEBUG still never prints form values or page HTML.
AUTO_APPLY_LOG_LEVEL=INFO
